import telebot
from telebot import types
                
                    
bot = telebot.TeleBot('')
 
@bot.message_handler(['start', 'Start'])
def start(msg:telebot.types.Message):
    markup = types.InlineKeyboardMarkup()
    
    bc = types.InlineKeyboardButton('comprar', callback_data='bc')
    bs = types.InlineKeyboardButton('sobre', callback_data='bs')
    markup.add(bc, bs)
    bot.send_message(msg.chat.id, 'olá', reply_markup=markup)
    
@bot.callback_query_handler()
def rb (call:types.CallbackQuery):
    match call.data:
        case 'bc':
            bot.send_message(call.message.chat.id, 'nenhum produto disponivel para venda')
        case 'bs':
            bot.send_message(call.message.chat.id, 'bot em programação com intuito de automatizar vendas')
    
                                                                                                 
bot.infinity_polling()
